# Copy to .env for local/docker-compose use.
# DATABASE_URL is set directly in docker-compose.yml for the backend service;
# only override it here if running the backend outside Docker.

ANTHROPIC_API_KEY=
PEXELS_API_KEY=

DEFAULT_SOURCE_PATH=

# --- Jira integration (chat tool-use + /jira page) ---
# API token from id.atlassian.com/manage-profile/security/api-tokens.
# Search is read-only; create/update always stage a proposal a human must
# confirm in the UI -- see backend/app/api/jira_actions.py.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_DEFAULT_PROJECT_KEY=

# --- Push sync (GitHub webhook -> vcode-w-hc) ---
# Generate with: openssl rand -hex 32
# Must match the "Secret" field on the GitHub webhook (repo Settings ->
# Webhooks -> Add webhook) exactly, or every delivery gets rejected as an
# invalid signature.
GITHUB_WEBHOOK_SECRET=

# Payload's repository.full_name -- the webhook ignores pushes from anything
# else even with a valid signature, in case the endpoint URL leaks.
SYNC_ALLOWED_SOURCE_REPO=hcmarella/vcode-w-hc
SYNC_SOURCE_URL=https://github.com/hcmarella/vcode-w-hc.git
SYNC_SOURCE_REF=main

# postgres (default, no extra infra) or sqs (prod/EKS -- see terraform/sqs.tf)
SYNC_QUEUE_BACKEND=postgres
SYNC_QUEUE_SQS_URL=
AWS_REGION=us-east-1

# --- GitHub PR stats (Reports page) ---
# Personal access token from github.com/settings/tokens ("Pull requests:
# Read" is enough). Optional for public repos -- only raises the 60 req/hr
# unauthenticated rate limit; required if any repo below is private.
GITHUB_TOKEN=
# Repos the Reports page pulls PR stats for. Fixed here rather than
# client-supplied, so the endpoint can't be used to proxy arbitrary GitHub
# reads through this server's token.
GITHUB_STATS_REPOS=hcmarella/vcode-fr-hc,hcmarella/vcode-w-hc
# Adds a few clearly-flagged fabricated PRs on top of real GitHub data, for
# demoing Reports before the real repos have much history. Leave false
# outside of demo prep.
GITHUB_STATS_DEMO_MODE=false

# --- ROI panel (Home dashboard) ---
# Blended fully-loaded hourly rate used to turn estimated time saved into a
# dollar figure on the Home dashboard's "Value delivered" panel.
ROI_HOURLY_RATE_USD=75
