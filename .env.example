# Copy to .env for local/docker-compose use.
# DATABASE_URL is set directly in docker-compose.yml for the backend service;
# only override it here if running the backend outside Docker.

ANTHROPIC_API_KEY=
PEXELS_API_KEY=

DEFAULT_SOURCE_PATH=

# --- Push sync (GitHub webhook -> vcode-w-hc) ---
# Generate with: openssl rand -hex 32
# Must match the "Secret" field on the GitHub webhook (repo Settings ->
# Webhooks -> Add webhook) exactly, or every delivery gets rejected as an
# invalid signature.
GITHUB_WEBHOOK_SECRET=

# Payload's repository.full_name -- the webhook ignores pushes from anything
# else even with a valid signature, in case the endpoint URL leaks.
SYNC_ALLOWED_SOURCE_REPO=hcmarella/vcode-w-hc
SYNC_SOURCE_URL=https://github.com/hcmarella/vcode-w-hc.git
SYNC_SOURCE_REF=main

# postgres (default, no extra infra) or sqs (prod/EKS -- see terraform/sqs.tf)
SYNC_QUEUE_BACKEND=postgres
SYNC_QUEUE_SQS_URL=
AWS_REGION=us-east-1
