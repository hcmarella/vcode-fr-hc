server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # SPA fallback -- any path not matching a real file goes to index.html so
    # react-router's client-side routes (e.g. /skills/pr-review) work on a
    # hard refresh, not just client-side navigation.
    location / {
        try_files $uri /index.html;
    }

    location /api/ {
        proxy_pass http://${BACKEND_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cookie_path / /;
    }

    location /healthz {
        proxy_pass http://${BACKEND_UPSTREAM};
    }

    # Static assets get long-lived caching; index.html itself must not be
    # cached or deploys wouldn't be visible until cache expiry.
    location ~* \.(js|css|svg|png|jpg|jpeg|woff2?)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
